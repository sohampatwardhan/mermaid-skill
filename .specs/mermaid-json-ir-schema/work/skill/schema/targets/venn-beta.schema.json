{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "venn-beta.schema.json",
  "title": "venn-beta canonical envelope",
  "description": "Mermaid 11.12.3+ venn-beta: sets, unions of two or more sets, and optional text labels placed inside them (see reference/syntax/venn.md). Presentational `style` statements are out of scope, matching this skill's content-not-presentation IR boundary.",
  "type": "object",
  "required": ["schemaVersion", "diagram", "target", "content"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": "1.0.0"},
    "diagram": {"const": "venn"},
    "target": {"const": "venn-beta"},
    "accessibility": {"$ref": "common.schema.json#/$defs/accessibility"},
    "source": {
      "type": "object",
      "properties": {"title": {"$ref": "common.schema.json#/$defs/nonEmptyText"}},
      "additionalProperties": false
    },
    "renderer": {"$ref": "config.schema.json#/$defs/renderer"},
    "extensions": {"type": "object"},
    "content": {
      "type": "object",
      "required": ["sets"],
      "additionalProperties": false,
      "properties": {
        "sets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "common.schema.json#/$defs/identifier"},
              "label": {"$ref": "common.schema.json#/$defs/nonEmptyText"},
              "size": {"type": "number", "minimum": 0},
              "texts": {"type": "array", "items": {"$ref": "#/$defs/textNode"}}
            }
          }
        },
        "unions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ids"],
            "additionalProperties": false,
            "properties": {
              "ids": {
                "type": "array",
                "minItems": 2,
                "items": {"$ref": "common.schema.json#/$defs/identifier"},
                "description": "Every id must reference a content.sets[].id declared earlier in the array."
              },
              "label": {"$ref": "common.schema.json#/$defs/nonEmptyText"},
              "size": {"type": "number", "minimum": 0},
              "texts": {"type": "array", "items": {"$ref": "#/$defs/textNode"}}
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "textNode": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/identifier"},
        "label": {"$ref": "common.schema.json#/$defs/nonEmptyText"}
      }
    }
  }
}
