{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "envelope.schema.json",
  "title": "Canonical Mermaid diagram envelope",
  "description": "Strict versioned boundary shared by every target module.",
  "type": "object",
  "required": ["schemaVersion", "diagram", "target", "content"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": "1.0.0"},
    "diagram": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "content": {"type": "object"},
    "accessibility": {"$ref": "common.schema.json#/$defs/accessibility"},
    "source": {"type": "object"},
    "renderer": {"$ref": "config.schema.json#/$defs/renderer"},
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^(?:[A-Za-z0-9-]+\\.)+[A-Za-z0-9-]+/.+$": {},
        "^[A-Za-z][A-Za-z0-9+.-]*://.+$": {}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
