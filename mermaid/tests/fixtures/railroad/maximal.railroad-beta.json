{
  "diagram": "grammar",
  "target": "railroad-beta",
  "title": "Expression Grammar",
  "accessibility": {
    "title": "Expression grammar",
    "description": "Expression rules\nwritten as constructors"
  },
  "rules": [
    {
      "name": "expression",
      "comment": {
        "style": "w3c",
        "text": "built from explicit constructors"
      },
      "expression": {
        "kind": "sequence",
        "items": [
          {
            "kind": "nonterminal",
            "name": "term"
          },
          {
            "kind": "zeroOrMore",
            "item": {
              "kind": "sequence",
              "items": [
                {
                  "kind": "choice",
                  "items": [
                    {
                      "kind": "terminal",
                      "text": "+"
                    },
                    {
                      "kind": "terminal",
                      "text": "-"
                    }
                  ]
                },
                {
                  "kind": "nonterminal",
                  "name": "term"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "name": "term",
      "expression": {
        "kind": "sequence",
        "items": [
          {
            "kind": "optional",
            "item": {
              "kind": "terminal",
              "text": "-"
            }
          },
          {
            "kind": "oneOrMore",
            "item": {
              "kind": "nonterminal",
              "name": "digit"
            }
          },
          {
            "kind": "special",
            "text": "any"
          }
        ]
      }
    },
    {
      "name": "digit",
      "expression": {
        "kind": "choice",
        "items": [
          {
            "kind": "terminal",
            "text": "0"
          },
          {
            "kind": "terminal",
            "text": "1"
          },
          {
            "kind": "terminal",
            "text": "2"
          },
          {
            "kind": "terminal",
            "text": "3"
          },
          {
            "kind": "terminal",
            "text": "4"
          },
          {
            "kind": "terminal",
            "text": "5"
          },
          {
            "kind": "terminal",
            "text": "6"
          },
          {
            "kind": "terminal",
            "text": "7"
          },
          {
            "kind": "terminal",
            "text": "8"
          },
          {
            "kind": "terminal",
            "text": "9"
          }
        ]
      }
    },
    {
      "name": "factor",
      "expression": {
        "kind": "choice",
        "items": [
          {
            "kind": "nonterminal",
            "name": "number"
          },
          {
            "kind": "sequence",
            "items": [
              {
                "kind": "terminal",
                "text": "("
              },
              {
                "kind": "nonterminal",
                "name": "expression"
              },
              {
                "kind": "terminal",
                "text": ")"
              }
            ]
          }
        ]
      }
    },
    {
      "name": "number",
      "expression": {
        "kind": "oneOrMore",
        "item": {
          "kind": "nonterminal",
          "name": "digit"
        }
      }
    }
  ]
}
