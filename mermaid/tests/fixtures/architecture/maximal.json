    {"id": "db", "label": "Database", "icon": "database", "group": "priv"},
    {"id": "disk1", "label": "Disk One", "icon": "disk", "group": "store"},
    {"id": "disk2", "label": "Disk Two", "icon": "disk", "group": "store"},
    {"id": "logs", "label": "Logs", "group": "store"},
